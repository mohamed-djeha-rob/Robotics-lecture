\begin{column}{0.4\textwidth}
\begin{block}{Planning Strategies}
\begin{enumerate}
\item \textbf{Forward search}: From initial state
\item \textbf{Backward search}: From goal state
\item \textbf{Means-ends analysis}: Difference reduction
\item \textbf{Hierarchical planning}: Multiple abstraction levels
\item \textbf{Reactive planning}: Sensor-driven
\end{enumerate}
\end{block}

\begin{alertblock}{STRIPS-like Representation}
\textbf{Preconditions}: What must be true\\
\textbf{Effects}: What becomes true/false\\
\textbf{Body}: How to achieve
\end{alertblock}
\end{column}
\end{columns}

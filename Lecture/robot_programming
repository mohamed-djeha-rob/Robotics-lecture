\begin{frame}{Motion Planning vs. Task Planning}
\begin{table}
\centering
\footnotesize
\begin{tabular}{p{0.45\textwidth}p{0.45\textwidth}}
\toprule
\textbf{Motion Planning} & \textbf{Task Planning} \\
\midrule
\textcolor{primary}{Continuous state space} & \textcolor{primary}{Discrete/symbolic state space} \\
Configuration space $C$ & Symbolic states \\
Collision-free paths & Action sequences \\
Workspace constraints & Logical constraints \\
\textit{Algorithms:} & \textit{Algorithms:} \\
- Roadmap methods & - STRIPS \\
- Cell decomposition & - Graph search \\
- Potential fields & - Planning graphs \\
\bottomrule
\end{tabular}
\end{table}

\begin{columns}[T]
\begin{column}{0.5\textwidth}
\begin{block}{Configuration Space (C-space)}
\[
C = \{\mathbf{q} : \mathbf{q} \text{ is a valid configuration}\}
\]
\[
C_{\text{free}} = \{\mathbf{q} \in C : \text{no collision}\}
\]
Planning: Find path $P \subset C_{\text{free}}$ from $\mathbf{q}_{\text{start}}$ to $\mathbf{q}_{\text{goal}}$
\end{block}
\end{column}

\begin{column}{0.5\textwidth}
\begin{block}{Task Planning Formalism}
\textbf{State}: Set of logical propositions\\
\textbf{Action}: $A = \langle \text{Pre}, \text{Add}, \text{Del} \rangle$\\
\textbf{Plan}: $\pi = [A_1, A_2, \ldots, A_n]$\\
Goal test: $G \subseteq S_{\text{final}}$
\end{block}
\end{column}
\end{columns}
\end{frame}

\begin{frame}{The Pick-and-Place Task in Detail}
\begin{columns}[T]
\begin{column}{0.6\textwidth}
\begin{block}{Complete Task Decomposition}
\begin{enumerate}
\item \textbf{Approach phase}: Move to pre-grasp position
\item \textbf{Grasp phase}: Close gripper on object
\item \textbf{Lift phase}: Remove from current location
\item \textbf{Transport phase}: Move to destination
\item \textbf{Place phase}: Position at destination
\item \textbf{Release phase}: Open gripper
\item \textbf{Depart phase}: Move away
\end{enumerate}
\end{block}

\begin{exampleblock}{State Transitions}
\begin{verbatim}
State 1: Object at source, gripper empty
→ APPROACH source
State 2: At pre-grasp position
→ GRASP
State 3: Object in gripper
→ LIFT
State 4: Object lifted
→ MOVE TO destination
...
\end{verbatim}
\end{exampleblock}
\end{column}


\begin{block}{Evolutionary Trends}
\begin{itemize}
\item \textbf{Level of abstraction}: Increasing from joint-level to task-level
\item \textbf{World model sophistication}: From none to complete CAD models
\item \textbf{Sensor integration}: From minimal to comprehensive multi-sensor
\item \textbf{Error handling}: From none to robust exception mechanisms
\end{itemize}
\end{block}
\end{frame}

\begin{frame}{Motion Specification in Robot Languages}
\begin{columns}[T]
\begin{column}{0.6\textwidth}
\begin{block}{Fundamental Motion Commands}
\begin{itemize}
\item \textbf{MOVE TO} \textlangle pose\textrangle: Absolute motion
\item \textbf{MOVE BY} \textlangle delta\textrangle: Relative motion
\item \textbf{APPROACH} \textlangle pose, distance\textrangle: Pre-positioning
\item \textbf{DEPART} \textlangle distance\textrangle: Post-motion retreat
\item \textbf{STRAIGHT} \textlangle pose\textrangle: Cartesian straight-line
\end{itemize}
\end{block}

\begin{exampleblock}{Example (VAL-style)}
\begin{verbatim}
MOVE P1    # Go to point P1
APPROACH P2, 50  # Approach 50mm from P2
CLOSEI    # Close gripper
DEPART 100  # Move away 100mm
\end{verbatim}
\end{exampleblock}
\end{column}

\begin{column}{0.4\textwidth}
\begin{block}{Frame Specification Methods}
\[
\text{Frame} = 
\begin{cases}
\text{Joint angles: } [\theta_1, \theta_2, \ldots, \theta_n] \\
\text{Cartesian: } [x, y, z, \phi, \theta, \psi] \\
\text{Transformation: } 
\begin{bmatrix}
n_x & o_x & a_x & p_x \\
n_y & o_y & a_y & p_y \\
n_z & o_z & a_z & p_z \\
0 & 0 & 0 & 1
\end{bmatrix}
\end{cases}
\]
\end{block}
\end{column}
\end{columns}
\end{frame}

\begin{frame}{Structured Programming Constructs}
\begin{columns}[T]
\begin{column}{0.5\textwidth}
\begin{block}{Control Structures}
\begin{itemize}
\item \textbf{IF-THEN-ELSE}: Conditional execution
\item \textbf{WHILE/REPEAT}: Loops
\item \textbf{CASE/SWITCH}: Multiple branches
\item \textbf{PROCEDURES}: Reusable code modules
\item \textbf{PARALLEL}: Concurrent execution
\end{itemize}
\end{block}

\begin{alertblock}{Robot-Specific Constructs}
\begin{itemize}
\item \textbf{AWAIT}: Wait for sensor condition
\item \textbf{SIGNAL}: Output to actuators
\item \textbf{INTERRUPT}: Event handling
\item \textbf{SPEED}: Motion velocity control
\end{itemize}
\end{alertblock}
\end{column}

\begin{column}{0.5\textwidth}
\begin{exampleblock}{Example: Assembly Task}
\begin{verbatim}
PROCEDURE insert_part()
  APPROACH insert_pose, 20
  SPEED slow
  WHILE force < 10 N DO
    MOVE BY 0,0,-1
    READ force_sensor
  END
  DEPART 30
  SIGNAL assembly_complete
END
\end{verbatim}
\end{exampleblock}

\begin{block}{Parallel Execution}
\texttt{PARALLEL BEGIN}\\
\quad \texttt{robot1.motion()} \\
\quad \texttt{conveyor.start()} \\
\quad \texttt{vision.inspect()} \\
\texttt{END}
\end{block}
\end{column}
\end{columns}
\end{frame}

\begin{frame}{World Modeling and Off-line Programming}
\begin{columns}[T]
\begin{column}{0.6\textwidth}
\begin{block}{World Model Components}
\begin{itemize}
\item \textbf{Geometric models}: Shapes, dimensions
\item \textbf{Kinematic models}: Joint limits, workspaces
\item \textbf{Dynamic models}: Mass, inertia, friction
\item \textbf{Process models}: Tasks, constraints
\item \textbf{Environment models}: Fixtures, obstacles
\end{itemize}
\end{block}

\vspace{0.5cm}
\begin{alertblock}{Off-line Programming Advantages}
\begin{itemize}
\item \textbf{No production downtime}
\item \textbf{CAD/CAM integration}
\item \textbf{Collision detection}
\item \textbf{Path optimization}
\item \textbf{Program verification}
\end{itemize}
\end{alertblock}
\end{column}


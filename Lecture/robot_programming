\end{itemize}
\end{alertblock}
\end{column}

\begin{column}{0.4\textwidth}
\begin{block}{Sensor-Guided Assembly}
\begin{verbatim}
WHILE inserting_part DO
  READ force_sensor(f_x, f_y, f_z)
  IF f_z > threshold THEN
    CORRECT lateral_error
  END
  IF insertion_depth > target THEN
    TERMINATE insertion
  END
END
\end{verbatim}
\end{block}

\begin{exampleblock}{Guarded Move}
\texttt{MOVE TO P1 UNTIL force > 10N}
\end{exampleblock}
\end{column}
\end{columns}

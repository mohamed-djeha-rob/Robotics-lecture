\section{Chapter 13: Task Planning}

\begin{frame}{The Task Planning Problem}
\begin{block}{Definition}
Given: \textbf{Initial state}, \textbf{Goal state}, and \textbf{Actions}\\
Find: \textbf{Sequence of actions} that transforms initial state to goal state
\end{block}

\begin{columns}[T]
\begin{column}{0.5\textwidth}
\begin{exampleblock}{Assembly Task Example}
\textbf{Initial State:}\\
Part A on conveyor\\
Part B in feeder\\
Gripper empty\\

\textbf{Goal State:}\\
A assembled with B\\
B in fixture\\

\textbf{Actions:}\\
Pick(A), Place(B), Insert(A,B), ...
\end{exampleblock}
\end{column}

\begin{column}{0.5\textwidth}
\begin{alertblock}{Challenges in Robot Task Planning}
\begin{itemize}
\item \textbf{Continuous state space}
\item \textbf{Uncertainty} in sensing/actuation
\item \textbf{Concurrent operations}
\item \textbf{Resource constraints}
\item \textbf{Temporal constraints}
\end{itemize}
\end{alertblock}
\end{column}
\end{columns}
\end{frame}


\section{Chapter 12: Robot Programming Languages}

\begin{frame}{Why Specialized Robot Programming Languages?}
\begin{columns}[T]
\begin{column}{0.6\textwidth}
\begin{block}{Unique Robot Requirements}
\begin{itemize}
\item \textbf{Motion specification}: Position, orientation, velocity
\item \textbf{Sensor integration}: Force, vision, proximity
\item \textbf{Concurrent operations}: Multiple coordinated motions
\item \textbf{World modeling}: Object relationships and constraints
\item \textbf{Error recovery}: Exception handling in physical world
\end{itemize}
\end{block}
\vspace{0.3cm}
\begin{alertblock}{Key Distinction}
Robot programming ≠ Computer programming\\
\textbf{Physical effects} and \textbf{uncertainty} dominate
\end{alertblock}
\end{column}

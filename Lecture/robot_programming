\begin{frame}{Error Recovery and Exception Handling}
\begin{columns}[T]
\begin{column}{0.5\textwidth}
\begin{block}{Common Errors in Robot Tasks}
\begin{enumerate}
\item \textbf{Grasp failure}: Object dropped/missed
\item \textbf{Collision}: Unexpected obstacle
\item \textbf{Jam}: Stuck in assembly
\item \textbf{Out of tolerance}: Position error
\item \textbf{Sensor failure}: No valid reading
\end{enumerate}
\end{block}

\begin{alertblock}{Recovery Strategies}
\begin{itemize}
\item \textbf{Retry}: Attempt same action
\item \textbf{Alternate approach}: Different strategy
\item \textbf{Replan}: Generate new plan
\item \textbf{Human intervention}: Operator assist
\item \textbf{System reset}: Return to known state
\end{itemize}
\end{alertblock}
\end{column}

\begin{column}{0.5\textwidth}
\begin{exampleblock}{Exception Handling Framework}
\begin{verbatim}
TRY
  pick_object(A)
  move_to(fixture)
  place_object(A)
EXCEPT
WHEN grasp_failed:
  reposition_gripper()
  RETRY
WHEN collision_detected:
  retreat_safely()
  replan_path()
WHEN timeout:
  signal_operator()
  WAIT
END
\end{verbatim}
\end{exampleblock}
\end{column}
\end{columns}
\end{frame}

